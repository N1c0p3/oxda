NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Firma las sesiones del sistema. Generar con: openssl rand -hex 32
AUTH_SECRET=

# Agente de Telegram
# Token que entrega @BotFather
TELEGRAM_BOT_TOKEN=
# Clave de la API de Claude (console.anthropic.com)
ANTHROPIC_API_KEY=
# Clave de OpenAI para entender notas de voz (platform.openai.com)
OPENAI_API_KEY=
# Secreto del webhook. Generar con: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Clave para entrar al panel /telegram. Generar con: openssl rand -base64 24
TELEGRAM_ADMIN_KEY=
# Opcional: otro modelo de Claude. Por defecto claude-haiku-5-5
# CLAUDE_MODEL=
# Opcional: otro modelo de transcripción. Por defecto gpt-transcribe
# OPENAI_TRANSCRIPTION_MODEL=
